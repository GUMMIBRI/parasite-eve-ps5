+void Psyz_CdAudioSnapshotLocked(struct PsyzCdAudioSnapshot *out) {
+    if (!out) return;
+    out->playing = is_playing;
+    out->xa_active = xa.active;
+    out->xa_decoded_count = xa.decoded_count;
+    out->xa_decoded_pos = xa.decoded_pos;
+    out->mode = CD_mode;
+    out->buffered_frames = cd_buf_count;
+    out->reader_installed = disk_read_cb != NULL;
+}
+
+void Psyz_CdAudioSnapshot(struct PsyzCdAudioSnapshot *out) {
+    if (!out) return;
+    Psyz_AudioLock();
+    Psyz_CdAudioSnapshotLocked(out);
+    Psyz_AudioUnlock();
+}
 
