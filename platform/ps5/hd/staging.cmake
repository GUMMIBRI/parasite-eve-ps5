# Standalone staging only. Inclusion with defaults creates no targets or SDL lookup.
option(PE_PS5_HD_STAGING "Build all independent HD foundations (no renderer hook)" OFF)
if(PE_PS5_HD_STAGING AND NOT TARGET pe-hd-staging)
    function(pe_hd_add_staging)
        set(PE_PS5_HD_IMAGE ON)
        set(PE_PS5_HD_CACHE ON)
        set(PE_PS5_HD_INDEX ON)
        set(PE_PS5_HD_PIPELINE ON)
        set(PE_PS5_HD_VRAM ON)
        set(PE_PS5_HD_GENERATION ON)
        set(PE_PS5_HD_LOOKUP ON)
        set(PE_PS5_HD_PACK ON)
        set(PE_PS5_HD_MANIFEST ON)
        if(NOT TARGET pe-ps5-hd-image)
            include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../cmake/ps5/hd.cmake")
        endif()
        if(NOT TARGET pe-ps5-hd-cache)
            include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../cmake/ps5/cache.cmake")
        endif()
        if(NOT TARGET pe-hd-index)
            include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/index.cmake")
        endif()
        if(NOT TARGET pe-hd-pipeline)
            include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/pipeline.cmake")
        endif()
        if(NOT TARGET pe-hd-vram)
            include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/vram.cmake")
        endif()
        if(NOT TARGET pe-hd-generation)
            include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/generation.cmake")
        endif()
        if(NOT TARGET pe-hd-lookup)
            include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/lookup.cmake")
        endif()
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/pack.cmake")
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/manifest.cmake")
        add_library(pe-hd-staging INTERFACE)
        target_link_libraries(pe-hd-staging INTERFACE pe-hd-lookup pe-hd-vram pe-hd-pack pe-hd-manifest)
    endfunction()
    pe_hd_add_staging()
endif()


