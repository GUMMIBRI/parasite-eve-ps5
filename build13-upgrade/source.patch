+        .usage=SDL_GPU_TEXTUREUSAGE_COLOR_TARGET|SDL_GPU_TEXTUREUSAGE_SAMPLER,
+        .width=VRAM_W*internal_res,.height=VRAM_H*internal_res,
+        .layer_count_or_depth=1,.num_levels=1};
