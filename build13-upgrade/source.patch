+typedef struct RoomM005_Dialog {
+    short h0;
+    short h2;
+    unsigned short h4;            /* 0x04: anchor x */
+    unsigned short h6;            /* 0x06: anchor y */
+    unsigned short h8;            /* 0x08: anchor z */
+    short hA;
+    short hC[1];                  /* 0x0C: fade target block */
+} RoomM005_Dialog;
