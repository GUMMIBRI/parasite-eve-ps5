+
+layout(location = 0) out vec4 FragColor;
+
+uint rgb5551ToU16(vec4 c) {
+    uint r = uint(c.r * 31.0 + 0.5);
+    uint g = uint(c.g * 31.0 + 0.5);
+    uint b = uint(c.b * 31.0 + 0.5);
+    uint a = uint(c.a + 0.5);
