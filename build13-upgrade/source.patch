-void Draw_MoveImage(PS1_RECT* rect, unsigned int x, unsigned int y) {
-    if (UseSoftwareBackend()) {
-        software_rasterizer.move_image(rect, x, y);
-        return;
-    }
-    if (rect->x == x && rect->y == y) {
-        return;
