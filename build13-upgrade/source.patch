+ if((unsigned)v->pad>=240)return 0;
+ /* Projection and original normal lookup walk parts in order: a later
+  * visible part overwrites a shared vertex. Match that ownership rather
+  * than taking the first range (or an earlier hidden part). */
+ unsigned part=o->header->part_count;
+ for(unsigned i=0;i<o->header->part_count;i++){
+     const RenderObjectPart*p=o->parts+i;
+     if(p->visible!=1)continue;
