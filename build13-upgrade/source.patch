+    case 1:
+        state->x += state->vx;
+        state->y += state->vy;
+        state->z += state->vz;
+        if (g_FieldFxCurrentAge >= 6) return 1;
+        break;
+    case 2:
+        matrixSlot = &g_ViewMatrixSlot;
+        gte_ldrotmatrix(matrixSlot->value);
+        gte_ldtransmatrix(matrixSlot->value);
