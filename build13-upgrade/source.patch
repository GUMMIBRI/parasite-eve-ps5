+static char *Host_Trim(char *s) {
+    while (isspace((unsigned char)*s)) {
+        ++s;
+    }
+    char *end = s + strlen(s);
+    while (end > s && isspace((unsigned char)end[-1])) {
+        --end;
+    }
+    *end = '\0';
+    return s;
+}
+
+/* Preferences use TOML tables, integers, booleans and single-line strings.
+ * Unknown keys remain harmless; malformed supported values are diagnosed. */
+static int Host_String(char *text, char *out, size_t size) {
+    char quote = *text++;
+    if (quote != '"' && quote != '\'') {
+        return 0;
+    }
+
+    size_t n = 0;
+    while (*text && *text != quote) {
+        unsigned char c = (unsigned char)*text++;
+        if (c < 32) {
+            return 0;
+        }
+        if (quote == '"' && c == '\\') {
+            c = (unsigned char)*text++;
+            if (c == 'n') {
+                c = '\n';
+            } else if (c == 'r') {
+                c = '\r';
+            } else if (c == 't') {
+                c = '\t';
+            } else if (c != '"' && c != '\\') {
+                return 0;
+            }
+        }
+        if (n + 1 >= size) {
+            return 0;
+        }
+        out[n++] = (char)c;
+    }
+    if (*text++ != quote) {
+        return 0;
+    }
+    while (isspace((unsigned char)*text)) {
+        ++text;
+    }
+    if (*text && *text != '#') {
+        return 0;
+    }
+    out[n] = '\0';
+    return 1;
+}
