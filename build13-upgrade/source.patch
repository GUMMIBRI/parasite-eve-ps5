+static SDL_GPUCommandBuffer* AcquireCmd(void) {
+    if (gpu_failed || !device) return NULL;
+    if (!pending_cmd) {
+        command_descriptors = 0;
+        pending_cmd = SDL_AcquireGPUCommandBuffer(device);
+        if (!pending_cmd) {
+            GpuFail("SDL_AcquireGPUCommandBuffer", false);
+        }
+    }
+    return pending_cmd;
+}
