+static float WidescreenViewHalf(float game_aspect) {
+    const float w = (float)display_size.x;
+    return SDL_floorf(
+        SDL_min(w * (16.0f / 9.0f) / game_aspect, w / WS_SQUEEZE) * 0.5f);
