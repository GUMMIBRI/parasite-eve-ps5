+ double a[3][3],co[3][3];
+ for(int r=0;r<3;r++)for(int c=0;c<3;c++)a[r][c]=m.rot[r][c]/4096.0;
+ for(int r=0;r<3;r++)for(int c=0;c<3;c++)co[r][c]=a[(r+1)%3][(c+1)%3]*a[(r+2)%3][(c+2)%3]-a[(r+1)%3][(c+2)%3]*a[(r+2)%3][(c+1)%3];
