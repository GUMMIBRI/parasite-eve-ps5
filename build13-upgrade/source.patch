-    Pgxp_LoadBoneMatrix(current, &f_cur);
-    *origin = 0;
-    *originY = 0;
-    out = actor->matrices;
-    commands = actor->matrix_commands;
-    centres = actor->animation_entries;
-    gte_ldrotmatrix(current);
