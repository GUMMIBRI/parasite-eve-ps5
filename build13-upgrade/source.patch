-            return 0;
-        }
-        if (quote == '"' && c == '\\') {
-            c = (unsigned char)*text++;
-            if (c == 'n') {
-                c = '\n';
-            } else if (c == 'r') {
-                c = '\r';
-            } else if (c == 't') {
-                c = '\t';
-            } else if (c != '"' && c != '\\') {
-                return 0;
-            }
-        }
-        if (n + 1 >= size) {
-            return 0;
-        }
