+    short h6;                     /* 0x06: size, ramps to 0x88 */
+    short h8;                     /* 0x08: orbit phase */
+    short hA;                     /* 0x0A: radius */
+    short hC;                     /* 0x0C: state */
+    short hE;                     /* 0x0E: fade counter */
+} RoomM005_OrbRec;
