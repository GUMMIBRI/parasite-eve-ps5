+static inline MemcardImageNode *MenuCard_FindImageNode(s32 kind) {
+    MemcardImageNode *node;
+
+    for (node = (g_MemcardActiveNodeHead); node != 0; node = node->next) {
+        if (node->kind == kind) {
+            break;
+        }
+    }
+    return node;
+}
