+/* File name only: reports are shared, and folders can hold the user's name. */
+static const char *Host_CrashFileName(const char *path) {
+    const char *name = path;
+    for (const char *s = path; *s; ++s) {
+        if (*s == '/' || *s == '\\') name = s + 1;
+    }
+    return *name ? name : "(not set)";
+}
