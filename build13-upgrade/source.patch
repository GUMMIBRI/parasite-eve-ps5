-/* Import once, retaining every legacy file and never replacing a newer card.
- * A completed-import marker prevents deleted slots reappearing at next launch. */
-typedef struct HostCardImport {
-    int ok;
-    unsigned count;
-    char *created[128];
-} HostCardImport;
