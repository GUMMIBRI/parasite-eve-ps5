+                pkt->sxy1 = xy1;
+                pkt->sxy2 = xy2;
+                Psyz_GteCopyPgxpSxy(&xy[a], &pkt->sxy0, xy0);
+                Psyz_GteCopyPgxpSxy(&xy[b], &pkt->sxy1, xy1);
+                Psyz_GteCopyPgxpSxy(&xy[c], &pkt->sxy2, xy2);
