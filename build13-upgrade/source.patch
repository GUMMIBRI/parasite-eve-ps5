+        InstallBrowse(4);
+        while(!s_install.cancel&&s_install.phase==PE_IV_BROWSER)InstallFrame();
+        selected=s_install.browser_selected&&!s_install.cancel;
+    }
+    int committed=0;status[0]=0;
+    if(selected&&!s_install.cancel){
