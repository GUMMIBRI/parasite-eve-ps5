+/* Display-only title material. Native RGB24 pixels remain the UI authority. */
+static SDL_Surface *title_image, *title_base, *title_output;
+static u8 *title_reference;
+static int title_width, title_height;
+/* Only the authored menu overlay may differ from the immutable background.
+ * Dimension compatibility alone cannot identify a title/logo scanout. */
+static SDL_Rect title_overlay;
+void Psyz_VideoBindRgb24BackdropOverlay(int x,int y,int width,int height) {
+    title_overlay=(SDL_Rect){0,0,0,0};
+    if(x<0||y<0||width<0||height<0||x>title_width||y>title_height||
+       width>title_width-x||height>title_height-y)return;
+    title_overlay=(SDL_Rect){x,y,width,height};
+}
+static bool IsRegisteredTitleDisplay(const u8 *rgb) {
+    if(!rgb||!title_reference)return false;
+    bool identified=false;
+    for(int y=0;y<title_height;y++)for(int x=0;x<title_width;x++) {
+        if(x>=title_overlay.x&&x<title_overlay.x+title_overlay.w&&
+           y>=title_overlay.y&&y<title_overlay.y+title_overlay.h)continue;
+        size_t at=((size_t)y*title_width+x)*3;
+        if(memcmp(rgb+at,title_reference+at,3))return false;
+        /* An all-black frame is not positive title identity. */
+        if(title_reference[at]||title_reference[at+1]||title_reference[at+2])identified=true;
+    }
+    return identified;
+}
+static char title_path[4096];
+static uint64_t title_hash;
+static unsigned title_generation, title_uploaded;
+static SDL_GPUTexture *title_texture;
+static SDL_GPUTransferBuffer *title_transfer;
+static unsigned title_texture_width, title_texture_height;
