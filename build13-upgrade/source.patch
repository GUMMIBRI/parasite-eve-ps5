+const mat4 ditherMatrix = mat4(
+    -4.0, +0.0, -3.0, +1.0,
+    +2.0, -2.0, +3.0, -1.0,
+    -3.0, +1.0, -4.0, +0.0,
+    +3.0, -1.0, +2.0, -2.0);
