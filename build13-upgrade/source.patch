-        MovieCleanupDestroy();
-        MovieBlurDestroy();
-#endif
-        DuckQuit();
-        DialogueFontDestroy();
-        if (sprite_atlas_texture) SDL_ReleaseGPUTexture(device,sprite_atlas_texture);
-        sprite_atlas_texture=NULL;sprite_atlas_cells=0;
-        sprite_atlas_count=0;sprite_atlas_bytes=0;next_sprite_atlas=NULL;
