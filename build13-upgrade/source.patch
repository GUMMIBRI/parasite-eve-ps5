+        ca[0] = v->a;
+        for (int i = 0; len > 0 && i < nPoints; i++) {
+            px[i] = s11(((short*)packets)[0]);
+            py[i] = s11(((short*)packets)[1]);
+            packets++;
+            len--;
+            parsed = i + 1;
+            if (len > 0 && i + 1 < nPoints && isGouraud) {
+                cr[i + 1] = ((u8*)packets)[0];
+                cg[i + 1] = ((u8*)packets)[1];
+                cb[i + 1] = ((u8*)packets)[2];
+                ca[i + 1] = code & SEMITRANSP ? 0x80 : 0xFF;
+                packets++;
+                len--;
+            }
+        }
+        if (!isGouraud) {
+            for (int i = 1; i < parsed; i++) {
+                cr[i] = cr[0];
+                cg[i] = cg[0];
+                cb[i] = cb[0];
+                ca[i] = ca[0];
+            }
+        }
+        if (padding) {
+            len--;
+        }
+
+        int nSegments = parsed - 1;
+        if (nSegments >= 1) {
+            // for LINE_*4: 12 verts, 18 indices
+            Draw_EnsureBufferWillNotOverflow(nSegments * 4, nSegments * 6);
+            for (int s = 0; s < nSegments; s++) {
+                short x0 = px[s];
+                short y0 = py[s];
+                short x1 = px[s + 1];
+                short y1 = py[s + 1];
+                int dx = x1 - x0;
+                int dy = y1 - y0;
+
+                // decides to thicken horizontally or vertically
+                short ox, oy, ex, ey;
+                if ((dx < 0 ? -dx : dx) >= (dy < 0 ? -dy : dy)) {
+                    ox = 0;
+                    oy = 1;
+                    ex = dx >= 0 ? 1 : -1;
+                    ey = 0;
+                } else {
+                    ox = 1;
+                    oy = 0;
+                    ex = 0;
+                    ey = dy >= 0 ? 1 : -1;
+                }
+
+                Vertex* q = vertex_cur;
+                unsigned short base = n_vertices;
+                q[0].x = x0;
+                q[0].y = y0;
+                q[1].x = (short)(x1 + ex);
+                q[1].y = (short)(y1 + ey);
+                q[2].x = (short)(x1 + ex + ox);
+                q[2].y = (short)(y1 + ey + oy);
+                q[3].x = (short)(x0 + ox);
+                q[3].y = (short)(y0 + oy);
+                q[0].r = cr[s];
+                q[0].g = cg[s];
+                q[0].b = cb[s];
+                q[0].a = ca[s];
+                q[3].r = cr[s];
+                q[3].g = cg[s];
+                q[3].b = cb[s];
+                q[3].a = ca[s];
+                q[1].r = cr[s + 1];
+                q[1].g = cg[s + 1];
+                q[1].b = cb[s + 1];
+                q[1].a = ca[s + 1];
+                q[2].r = cr[s + 1];
+                q[2].g = cg[s + 1];
+                q[2].b = cb[s + 1];
+                q[2].a = ca[s + 1];
+                u16 lt = cur_tpage | TPAGE_NOTEXTURE;
+                if (CanLineDither()) {
+                    lt |= TPAGE_DITHER;
+                }
+                for (int k = 0; k < 4; k++) {
+                    q[k].hd_uv[0] = q[k].hd_uv[1] = q[k].hd_uv[2] = 0;
+                    q[k].pgxp_pos[0] = (float)q[k].x;
+                    q[k].pgxp_pos[1] = (float)q[k].y;
+                    q[k].pgxp_pos[2] = -1.0f;
+                    SET_TC(&q[k], lt, -1);
+                }
+                index_cur[0] = base + 0;
+                index_cur[1] = base + 1;
+                index_cur[2] = base + 2;
+                index_cur[3] = base + 0;
+                index_cur[4] = base + 2;
+                index_cur[5] = base + 3;
+                Draw_EnqueueBuffer(4, 6);
+            }
+        }
+    } else if (isTile) {
+        int x, y, w, h, tu, tv;
+        x = s11(((short*)packets)[0]);
+        y = s11(((short*)packets)[1]);
+        packets++;
+        len--;
+        if (isTextured) {
+            tu = ((u8*)packets)[0];
+            tv = ((u8*)packets)[1];
+            clut = ((s16*)packets)[1];
+            tpage = cur_tpage;
+            packets++;
+            len--;
+        } else {
+            clut = -1;
+            tpage = cur_tpage | TPAGE_NOTEXTURE;
+        }
+        switch (code & ~3) {
+        case 0x60: // TILE
+        case 0x64: // SPRT
+            w = ((s16*)packets)[0];
+            h = ((s16*)packets)[1];
+            packets++;
+            len--;
+            break;
+        case 0x68: // TILE_1
+        case 0x6C:
+            w = 1;
+            h = 1;
+            break;
+        case 0x70: // TILE_8
+        case 0x74: // SPRT_8
+            w = 8;
+            h = 8;
+            break;
+        case 0x78: // TILE_16
+        case 0x7C: // SPRT_16
+            w = 16;
+            h = 16;
+            break;
+        default:
+            // TODO warn about unrecognized code
+            break;
+        }
+        vertex_cur[0].x = (short)(x);
+        vertex_cur[0].y = (short)(y);
+        vertex_cur[1].x = (short)(x + w);
+        vertex_cur[1].y = (short)(y);
+        vertex_cur[2].x = (short)(x);
+        vertex_cur[2].y = (short)(y + h);
+        vertex_cur[3].x = (short)(x + w);
+        vertex_cur[3].y = (short)(y + h);
+        if (isTextured) {
+            vertex_cur[0].u = tu;
+            vertex_cur[0].v = tv;
+            vertex_cur[1].u = tu + w;
+            vertex_cur[1].v = tv;
+            vertex_cur[2].u = tu;
+            vertex_cur[2].v = tv + h;
+            vertex_cur[3].u = tu + w;
+            vertex_cur[3].v = tv + h;
+            /* Widescreen: a squeezed sprite reads only its own texels
+             * (psx.frag.glsl); otherwise the bounds hold anything. */
+            const bool own_texels = WidescreenDraw();
+            for (int i = 0; i < 4; ++i) {
+                vertex_cur[i].uv_bounds[0] = own_texels ? (float)tu : -32768.0f;
+                vertex_cur[i].uv_bounds[1] = own_texels ? (float)tv : -32768.0f;
+                vertex_cur[i].uv_bounds[2] =
+                    own_texels ? (float)(tu + w - 1) : 32767.0f;
+                vertex_cur[i].uv_bounds[3] =
+                    own_texels ? (float)(tv + h - 1) : 32767.0f;
+            }
+        }
+        VRGBA(vertex_cur[1]) = VRGBA(vertex_cur[2]) = VRGBA(vertex_cur[3]) =
+            VRGBA(vertex_cur[0]);
+        if (!isTextured) {
+            WidenFullWidthFill(vertex_cur, 4);
+        }
+        index_cur[0] = n_vertices + 0;
+        index_cur[1] = n_vertices + 1;
+        index_cur[2] = n_vertices + 2;
+        index_cur[3] = n_vertices + 1;
+        index_cur[4] = n_vertices + 3;
+        index_cur[5] = n_vertices + 2;
+        if (atlas) {
+            float width=(float)HD_ATLAS_WIDTH,height=(float)HD_ATLAS_HEIGHT;
+            atlas_cell+=atlas->first_cell;
+            float left=(float)((atlas_cell%HD_ATLAS_COLUMNS)*68+2),top=(float)((atlas_cell/HD_ATLAS_COLUMNS)*68+2);
+            for (int i=0;i<4;++i) {
+                vertex_cur[i].hd_uv[0]=(left+((i&1)?64.0f:0.0f))/width;
+                vertex_cur[i].hd_uv[1]=(top+((i&2)?64.0f:0.0f))/height;
+                vertex_cur[i].hd_uv[2]=atlas_extension?(widescreen&&sprite_atlases_enabled?2:3):(sprite_atlases_enabled?1:0);
+            }
+        }
+        for (int i = 0; i < 4; ++i) {
+            vertex_cur[i].pgxp_pos[0] = (float)vertex_cur[i].x;
+            vertex_cur[i].pgxp_pos[1] = (float)vertex_cur[i].y;
+            vertex_cur[i].pgxp_pos[2] = -1.0f;
+        }
+        if(dialogue_glyph>=0&&w==12&&h==12){
+            float left=(float)((dialogue_glyph%8)*52+2),top=(float)((dialogue_glyph/8)*52+2);
+            for(int i=0;i<4;i++){vertex_cur[i].hd_uv[0]=(left+((i&1)?48.0f:0.0f))/416.0f;vertex_cur[i].hd_uv[1]=(top+((i&2)?48.0f:0.0f))/520.0f;vertex_cur[i].hd_uv[2]=4.0f;}
+            dialogue_font_batch=font_context;
+        }else dialogue_glyph=-1;
+        if(isTextured&&!atlas&&!atlas_extension&&dialogue_glyph<0&&!particle_material)DuckApplyUi(vertex_cur,4,tpage,clut);
+        SET_TC_ALL(vertex_cur, tpage, clut);
+        Draw_EnqueueBuffer(4, 6);
+    }
+    batch_has_texture |= isTextured;
+    return max_len - len;
+}
