-static void Host_WriteString(FILE *file, const char *value) {
-    fputc('"', file);
-    for (const unsigned char *s = (const unsigned char *)value; *s; ++s) {
-        if (*s == '\\' || *s == '"') {
-            fputc('\\', file);
-        }
-        if (*s == '\n') {
-            fputs("\\n", file);
-        } else if (*s == '\r') {
-            fputs("\\r", file);
-        } else if (*s == '\t') {
-            fputs("\\t", file);
-        } else {
-            fputc(*s, file);
-        }
-    }
-    fputc('"', file);
-}
