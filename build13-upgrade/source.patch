+            // target
+            SDL_GPUCommandBuffer* cmd = ReserveDrawDescriptors(1);
+            if (cmd) {
+                const SDL_GPUBlitInfo blit = {
+                    .source = {.texture = vram_render,
+                               .w = VRAM_W,
+                               .h = VRAM_H},
+                    .destination = {.texture = scaled_vram_render,
+                                    .w = VRAM_W * n,
+                                    .h = VRAM_H * n},
