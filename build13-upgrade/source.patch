+#ifdef PE_PS5_GPU_NATIVE
+extern int sceSystemServiceHideSplashScreen(void);
+static bool shell_display_handoff_done;
+static unsigned shell_display_handoff_attempts;
+static void CompleteShellDisplayHandoff(bool submitted_display) {
+    /* A swapchain-bearing normal display command was accepted by SDL/Vulkan.
+     * Resource uploads and fences alone cannot transfer shell ownership.
+     * Retry only on another real presented frame, capped to avoid log spam. */
+    if (!submitted_display || shell_display_handoff_done ||
+        shell_display_handoff_attempts >= 3) return;
+    ++shell_display_handoff_attempts;
+    int result = sceSystemServiceHideSplashScreen();
+    shell_display_handoff_done = result == 0;
+    INFOF("Display handoff: submitted-frame splash-dismiss result=0x%08x attempt=%u",
+          (unsigned)result, shell_display_handoff_attempts);
+}
+#else
+static void CompleteShellDisplayHandoff(bool submitted_display) { (void)submitted_display; }
+#endif
+
+static bool SubmitCmd(void) {
+    if (gpu_failed) return false;
+    if (pending_cmd) {
+        SDL_GPUCommandBuffer *cmd = pending_cmd;
+        pending_cmd = NULL; /* consumed by SDL on both results */
+        if (!SDL_SubmitGPUCommandBuffer(cmd)) {
+            quarantined_cmd = cmd; /* evidence only; never dereference */
+            present_commit_pending=false;return GpuFail("SDL_SubmitGPUCommandBuffer", true);
+        }
+        RecordPresentedCommit();
+    }
+    return true;
+}
+static bool RetireGpu(void) {
+    if (gpu_retirement_uncertain) return false;
+    if (!SubmitCmd()) {
+        /* Acquisition failure can leave a previously recorded buffer. Do not
+         * erase or reclaim that graph on a terminal backend failure. */
+        gpu_retirement_uncertain = true;
+        return false;
+    }
+    if (!SDL_WaitForGPUIdle(device)) return GpuFail("SDL_WaitForGPUIdle", true);
+    return true;
+}
